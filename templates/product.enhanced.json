{
  "sections": {
    "product_3d_intro": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n  .product-page-3d-wrapper {\n    perspective: 2000px;\n    transform-style: preserve-3d;\n  }\n  \n  .product-badge-3d {\n    position: absolute;\n    top: 20px;\n    right: 20px;\n    background: linear-gradient(135deg, #f5576c, #e73c7e);\n    color: white;\n    padding: 10px 20px;\n    border-radius: 30px;\n    font-weight: bold;\n    transform: perspective(500px) rotateY(-15deg);\n    box-shadow: 0 10px 30px rgba(245, 87, 108, 0.5);\n    animation: float 4s ease-in-out infinite;\n    z-index: 100;\n  }\n  \n  .product-sparkle-container {\n    position: relative;\n    overflow: visible;\n  }\n  \n  .product-sparkle-container::before {\n    content: '✨';\n    position: absolute;\n    top: -30px;\n    right: -30px;\n    font-size: 3rem;\n    animation: float 3s ease-in-out infinite;\n    z-index: 1;\n  }\n<\/style>\n\n<div class='product-page-3d-wrapper'>\n  <div class='product-sparkle-container'>\n    <span class='product-badge-3d'>New Arrival</span>\n  <\/div>\n<\/div>"
      }
    },
    "main": {
      "type": "product-information",
      "blocks": {
        "media-gallery": {
          "type": "_product-media-gallery",
          "static": true,
          "settings": {
            "media_presentation": "grid",
            "media_columns": "two",
            "image_gap": 16,
            "large_first_image": true,
            "icons_style": "none",
            "slideshow_controls_style": "counter",
            "slideshow_mobile_controls_style": "dots",
            "thumbnail_position": "left",
            "thumbnail_width": 50,
            "aspect_ratio": "portrait",
            "constrain_to_viewport": true,
            "media_fit": "contain",
            "media_radius": 16,
            "extend_media": false,
            "zoom": true,
            "video_loop": false,
            "hide_variants": true,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          }
        },
        "product-details": {
          "type": "_product-details",
          "static": true,
          "settings": {
            "width": "fill",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "details_position": "flex-start",
            "gap": 32,
            "sticky_details_desktop": true,
            "inherit_color_scheme": true,
            "color_scheme": "scheme-1",
            "background_media": "none",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 24,
            "padding-block-end": 24,
            "padding-inline-start": 24,
            "padding-inline-end": 24
          },
          "blocks": {
            "product_title_enhanced": {
              "type": "text",
              "settings": {
                "text": "<h1 style='background: linear-gradient(135deg, #667eea, #764ba2, #f093fb); -webkit-background-clip: text; -webkit-text-fill-color: transparent; animation: float-slow 6s ease-in-out infinite; font-size: 3rem; font-weight: bold; margin-bottom: 20px;'>{{ product.title }}</h1>",
                "width": "100%",
                "alignment": "left",
                "type_preset": "h1"
              }
            },
            "price_3d": {
              "type": "price",
              "settings": {
                "show_sale_price_first": true,
                "show_installments": true,
                "show_tax_info": false,
                "type_preset": "h3",
                "width": "100%",
                "alignment": "left",
                "font_size": "2rem",
                "color": "#f5576c"
              }
            },
            "rating_stars": {
              "type": "text",
              "settings": {
                "text": "<div style='display: flex; align-items: center; gap: 10px; margin: 20px 0;'><span style='color: #ffd700; font-size: 1.5rem;'>⭐⭐⭐⭐⭐</span><span style='color: #666; font-size: 1.1rem;'>(128 reviews)</span></div>",
                "type_preset": "body"
              }
            },
            "description_enhanced": {
              "type": "text",
              "settings": {
                "text": "<div style='background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); padding: 30px; border-radius: 20px; border: 1px solid rgba(255, 255, 255, 0.2); box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1); margin: 20px 0;'>\n  <h3 style='color: #f5576c; margin-bottom: 15px; font-size: 1.5rem;'>💎 Product Details</h3>\n  <p style='line-height: 1.8; font-size: 1.1rem;'>{{ product.description }}</p>\n</div>",
                "type_preset": "body"
              }
            },
            "variant_picker_3d": {
              "type": "variant-picker",
              "settings": {
                "variant_picker_style": "buttons",
                "show_variant_labels": true,
                "color_swatches": true
              }
            },
            "quantity_selector": {
              "type": "quantity-selector",
              "settings": {}
            },
            "add_to_cart_enhanced": {
              "type": "add-to-cart",
              "settings": {
                "style_class": "velvet-button"
              }
            },
            "features_list": {
              "type": "text",
              "settings": {
                "text": "<div style='margin: 30px 0;'>\n  <h4 style='color: #764ba2; font-size: 1.3rem; margin-bottom: 15px;'>✨ Key Features</h4>\n  <ul style='list-style: none; padding: 0;'>\n    <li style='padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.1);'>🌸 Premium Quality Fabric</li>\n    <li style='padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.1);'>💫 Elegant Design</li>\n    <li style='padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.1);'>🎀 Perfect Fit</li>\n    <li style='padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.1);'>🛡️ Easy Care</li>\n    <li style='padding: 10px 0;'>🚚 Free Shipping</li>\n  </ul>\n</div>",
                "type_preset": "body"
              }
            },
            "trust_badges": {
              "type": "text",
              "settings": {
                "text": "<div style='display: flex; gap: 20px; margin: 30px 0; flex-wrap: wrap;'>\n  <div style='background: linear-gradient(135deg, #667eea, #764ba2); color: white; padding: 15px 25px; border-radius: 15px; font-weight: bold; animation: float 5s ease-in-out infinite;'>✓ 30 Day Returns</div>\n  <div style='background: linear-gradient(135deg, #f093fb, #f5576c); color: white; padding: 15px 25px; border-radius: 15px; font-weight: bold; animation: float 6s ease-in-out infinite;'>✓ Secure Checkout</div>\n  <div style='background: linear-gradient(135deg, #23d5ab, #23a6d5); color: white; padding: 15px 25px; border-radius: 15px; font-weight: bold; animation: float 7s ease-in-out infinite;'>✓ Free Shipping</div>\n</div>",
                "type_preset": "body"
              }
            }
          },
          "block_order": [
            "product_title_enhanced",
            "price_3d",
            "rating_stars",
            "description_enhanced",
            "variant_picker_3d",
            "quantity_selector",
            "add_to_cart_enhanced",
            "features_list",
            "trust_badges"
          ]
        }
      },
      "settings": {
        "content_width": "content-center-aligned",
        "desktop_media_position": "left",
        "equal_columns": false,
        "limit_details_width": false,
        "gap": 60,
        "color_scheme": "scheme-1",
        "padding-block-start": 60,
        "padding-block-end": 60
      }
    },
    "product_features_showcase": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div style='background: linear-gradient(135deg, #f093fb 0%, #f5576c 50%, #fda085 100%); padding: 80px 20px; text-align: center; position: relative; overflow: hidden;'>\n  <div style='position: relative; z-index: 2;'>\n    <h2 style='color: white; font-size: 3rem; margin-bottom: 40px; text-shadow: 0 10px 30px rgba(0,0,0,0.3); animation: float-slow 6s ease-in-out infinite;'>🌟 Why You'll Love It 🌟</h2>\n    <div style='display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 30px; max-width: 1200px; margin: 0 auto;'>\n      <div class='crystal-card' style='padding: 40px; text-align: center; animation: card-entrance 0.8s ease-out backwards;'>\n        <div style='font-size: 4rem; margin-bottom: 20px;'>👗</div>\n        <h3 style='color: white; font-size: 1.5rem; margin-bottom: 15px;'>Premium Quality</h3>\n        <p style='color: rgba(255,255,255,0.9);'>Crafted with the finest materials for ultimate comfort and durability.</p>\n      </div>\n      <div class='crystal-card' style='padding: 40px; text-align: center; animation: card-entrance 1s ease-out backwards;'>\n        <div style='font-size: 4rem; margin-bottom: 20px;'>✨</div>\n        <h3 style='color: white; font-size: 1.5rem; margin-bottom: 15px;'>Elegant Design</h3>\n        <p style='color: rgba(255,255,255,0.9);'>Timeless style that makes you feel confident and beautiful.</p>\n      </div>\n      <div class='crystal-card' style='padding: 40px; text-align: center; animation: card-entrance 1.2s ease-out backwards;'>\n        <div style='font-size: 4rem; margin-bottom: 20px;'>💖</div>\n        <h3 style='color: white; font-size: 1.5rem; margin-bottom: 15px;'>Perfect Fit</h3>\n        <p style='color: rgba(255,255,255,0.9);'>Designed to flatter every body type with precision tailoring.</p>\n      </div>\n    </div>\n  </div>\n  <div style='position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0.1; background-image: repeating-linear-gradient(45deg, transparent, transparent 10px, rgba(255,255,255,0.1) 10px, rgba(255,255,255,0.1) 20px);'></div>\n</div>"
      }
    },
    "product_recommendations_3d": {
      "type": "product-recommendations",
      "blocks": {
        "recommendation_header": {
          "type": "text",
          "settings": {
            "text": "<h2 style='text-align: center; font-size: 2.5rem; background: linear-gradient(135deg, #667eea, #764ba2); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-bottom: 50px; animation: float-slow 6s ease-in-out infinite;'>💫 Complete Your Look 💫</h2>",
            "type_preset": "h2"
          }
        },
        "static-product-card": {
          "type": "_product-card",
          "static": true,
          "settings": {
            "product_card_gap": 12,
            "inherit_color_scheme": true,
            "color_scheme": "scheme-1",
            "border": "solid",
            "border_width": 1,
            "border_opacity": 20,
            "border_radius": 20,
            "padding-block-start": 0,
            "padding-block-end": 12,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          }
        }
      },
      "block_order": ["recommendation_header"],
      "settings": {
        "recommendation_type": "related",
        "layout_type": "grid",
        "carousel_on_mobile": true,
        "max_products": 4,
        "columns": 4,
        "mobile_columns": "2",
        "columns_gap": 24,
        "rows_gap": 24,
        "section_width": "page-width",
        "gap": 40,
        "color_scheme": "scheme-2",
        "padding-block-start": 80,
        "padding-block-end": 80
      }
    },
    "product_3d_effects": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<script>\n(function() {\n  'use strict';\n  \n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', initProductPage3D);\n  } else {\n    initProductPage3D();\n  }\n  \n  function initProductPage3D() {\n    \/\/ Product images 3D effect\n    const productImages = document.querySelectorAll('.product-media img, .product__media img');\n    productImages.forEach(img => {\n      img.style.transition = 'transform 0.3s ease, filter 0.3s ease';\n      img.style.borderRadius = '16px';\n      \n      img.addEventListener('mouseenter', function() {\n        this.style.transform = 'scale(1.05) translateZ(20px)';\n        this.style.filter = 'brightness(1.1) saturate(1.2)';\n        this.style.boxShadow = '0 20px 60px rgba(0,0,0,0.3)';\n      });\n      \n      img.addEventListener('mouseleave', function() {\n        this.style.transform = 'scale(1) translateZ(0)';\n        this.style.filter = 'brightness(1) saturate(1)';\n        this.style.boxShadow = '';\n      });\n    });\n    \n    \/\/ Add to Cart button enhancement\n    const addToCartBtn = document.querySelector('[name=\"add\"], .product-form__submit, button[type=\"submit\"]');\n    if (addToCartBtn) {\n      addToCartBtn.classList.add('velvet-button');\n      addToCartBtn.style.width = '100%';\n      addToCartBtn.style.padding = '20px';\n      addToCartBtn.style.fontSize = '1.2rem';\n      addToCartBtn.style.cursor = 'pointer';\n      addToCartBtn.style.border = 'none';\n      \n      addToCartBtn.addEventListener('click', function() {\n        \/\/ Celebration animation\n        for (let i = 0; i < 20; i++) {\n          setTimeout(() => {\n            createCelebrationParticle();\n          }, i * 30);\n        }\n      });\n    }\n    \n    function createCelebrationParticle() {\n      const colors = ['#f5576c', '#f093fb', '#667eea', '#fda085', '#23d5ab'];\n      const particle = document.createElement('div');\n      particle.style.cssText = `\n        position: fixed;\n        top: 50%;\n        left: 50%;\n        width: 12px;\n        height: 12px;\n        background: ${colors[Math.floor(Math.random() * colors.length)]};\n        border-radius: 50%;\n        pointer-events: none;\n        z-index: 10000;\n        animation: celebrate 1.5s ease-out forwards;\n      `;\n      \n      document.body.appendChild(particle);\n      setTimeout(() => particle.remove(), 1500);\n    }\n    \n    \/\/ Add animation styles\n    if (!document.getElementById('product-3d-styles')) {\n      const style = document.createElement('style');\n      style.id = 'product-3d-styles';\n      style.textContent = `\n        @keyframes celebrate {\n          to {\n            transform: translate(${Math.random() * 400 - 200}px, ${Math.random() * 400 - 200}px) rotate(${Math.random() * 720}deg) scale(0);\n            opacity: 0;\n          }\n        }\n        \n        .product-card {\n          transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;\n        }\n        \n        .product-card:hover {\n          transform: translateY(-15px) scale(1.05) !important;\n          box-shadow: 0 30px 60px rgba(0, 0, 0, 0.3) !important;\n        }\n      `;\n      document.head.appendChild(style);\n    }\n  }\n})();\n<\/script>"
      }
    }
  },
  "order": [
    "product_3d_intro",
    "main",
    "product_features_showcase",
    "product_recommendations_3d",
    "product_3d_effects"
  ]
}
