<div class="page-width">
  <div class="search-page">
    <h1 class="page-title">{{ 'general.search.title' | t }}</h1>
    
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <input type="search" 
             name="q" 
             value="{{ search.terms | escape }}" 
             placeholder="{{ 'general.search.placeholder' | t }}"
             class="search-form__input"
             aria-label="{{ 'general.search.placeholder' | t }}">
      <button type="submit" class="btn">
        {{ 'general.search.submit' | t }}
      </button>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <p class="search-results-count">
          {{ 'general.search.results_count' | t: count: search.results_count }}
        </p>

        <div class="product-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          {% render 'pagination', paginate: paginate %}
        {%- endif -%}
      {%- else -%}
        <div class="search-no-results">
          <p>{{ 'general.search.no_results' | t: terms: search.terms }}</p>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>
