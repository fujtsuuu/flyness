me-1","toggle_overlay":true,"overlay_color":"#00000040","overlay_style":"gradient","gradient_direction":"to top","blurred_reflection":false,"reflection_opacity":75,"padding-block-start":0,"padding-block-end":0}},"custom_css_loader":{"type":"custom-liquid","settings":{"custom_liquid":"<link rel='stylesheet' href='{{ '3d-animations.css' | asset_url }}' media='all'>\n<style>\n  .hero-3d { transform-style: preserve-3d; }\n  .collection-card-wrapper { perspective: 1200px; }\n  .product-card { transform-style: preserve-3d; transition: transform 0.4s ease; }\n  .product-card:hover { transform: translateZ(30px) rotateX(5deg); }\n<\/style>"}},"collection_links_3d":{"type":"collection-links","blocks":{"collection_1":{"type":"collection","settings":{"collection":"","title":"👗 Elegant Dresses","link":"shopify:\/\/collections","media_type":"image"}},"collection_2":{"type":"collection","settings":{"collection":"","title":"👚 Chic Tops","link":"shopify:\/\/collections","media_type":"image"}},"collection_3":{"type":"collection","settings":{"collection":"","title":"👖 Trendy Bottoms","link":"shopify:\/\/collections","media_type":"image"}},"collection_4":{"type":"collection","settings":{"collection":"","title":"💎 Accessories","link":"shopify:\/\/collections","media_type":"image"}}},"block_order":["collection_1","collection_2","collection_3","collection_4"],"settings":{"heading":"Shop By Category","subheading":"Explore our curated collections","columns_mobile":"2","columns_desktop":"4","content_alignment":"center","show_titles":true,"show_descriptions":false,"image_style":"square","color_scheme":"scheme-1","padding-block-start":80,"padding-block-end":80}},"featured_products_3d":{"type":"product-list","settings":{"heading":"Featured Styles","subheading":"✨ Handpicked favorites with 3D preview","collection":"","product_count":4,"columns_mobile":"2","columns_desktop":"4","show_secondary_image":true,"show_vendor":false,"show_rating":false,"color_scheme":"scheme-2","padding-block-start":80,"padding-block-end":80}},"media_with_text_floating":{"type":"media-with-content","blocks":{"heading_1":{"type":"text","settings":{"text":"<p class='float-slow'>🌸 New Season Collection<\/p>","type_preset":"h2"}},"text_1":{"type":"text","settings":{"text":"<p>Refresh your wardrobe with our latest collection. From elegant dresses to casual everyday wear, find pieces that make you feel confident and beautiful. Experience fashion in a whole new dimension.<\/p>","type_preset":"body"}},"button_1":{"type":"button","settings":{"label":"Discover More","link":"shopify:\/\/collections\/all","style_class":"button-secondary scale-3d"}}},"block_order":["heading_1","text_1","button_1"],"settings":{"media_type":"image","media_position":"left","content_alignment":"left","section_width":"page-width","color_scheme":"scheme-1","padding-block-start":80,"padding-block-end":80}},"bestsellers_animated":{"type":"product-list","settings":{"heading":"Bestsellers","subheading":"⭐ Customer favorites with stunning animations","collection":"","product_count":8,"columns_mobile":"2","columns_desktop":"4","show_secondary_image":true,"show_vendor":false,"show_rating":true,"color_scheme":"scheme-1","padding-block-start":80,"padding-block-end":80}},"lookbook_3d":{"type":"media-with-content","blocks":{"heading_2":{"type":"text","settings":{"text":"<p class='shimmer'>💫 Style Lookbook<\/p>","type_preset":"h2"}},"text_2":{"type":"text","settings":{"text":"<p>Get inspired by our latest lookbook featuring 3D interactive previews. Mix and match pieces to create your unique style statement. Fashion meets technology.<\/p>","type_preset":"body"}},"button_2":{"type":"button","settings":{"label":"View Lookbook","link":"shopify:\/\/pages\/about","style_class":"button-primary button-3d"}}},"block_order":["heading_2","text_2","button_2"],"settings":{"media_type":"image","media_position":"right","content_alignment":"left","section_width":"page-width","color_scheme":"scheme-2","padding-block-start":80,"padding-block-end":100}},"animation_script":{"type":"custom-liquid","settings":{"custom_liquid":"<script>\n  document.addEventListener('DOMContentLoaded', function() {\n    \/\/ Add 3D tilt effect on product cards\n    const cards = document.querySelectorAll('.product-card, .collection-card');\n    cards.forEach(card => {\n      card.addEventListener('mousemove', (e) => {\n        const rect = card.getBoundingClientRect();\n        const x = e.clientX - rect.left;\n        const y = e.clientY - rect.top;\n        const centerX = rect.width \/ 2;\n        const centerY = rect.height \/ 2;\n        const rotateX = (y - centerY) \/ 10;\n        const rotateY = (centerX - x) \/ 10;\n        card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.05, 1.05, 1.05)`;\n      });\n      card.addEventListener('mouseleave', () => {\n        card.style.transform = 'perspective(1000px) rotateX(0) rotateY(0) scale3d(1, 1, 1)';\n      });\n    });\n    \n    \/\/ Scroll animations\n    const observerOptions = { threshold: 0.1, rootMargin: '0px 0px -100px 0px' };\n    const observer = new IntersectionObserver((entries) => {\n      entries.forEach(entry => {\n        if (entry.isIntersecting) {\n          entry.target.classList.add('in-view');\n        }\n      });\n    }, observerOptions);\n    \n    document.querySelectorAll('section').forEach(section => {\n      section.classList.add('animate-on-scroll');\n      observer.observe(section);\n    });\n  });\n<\/script>"}}},"order":["hero_3d","custom_css_loader","collection_links_3d","featured_products_3d","media_with_text_floating","bestsellers_animated","lookbook_3d","animation_script"]}